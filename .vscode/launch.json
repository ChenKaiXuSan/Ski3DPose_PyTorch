{
  "configurations": [
    {
      "name": "Python 调试程序: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "sam3d_body",
      "type": "debugpy",
      "request": "launch",
      "python": "/opt/conda/envs/sam_3d_body/bin/python",
      "module": "SAM3Dbody.main_ski_pose_ptz",
    },
    {
      "name": "sam3_infer",
      "type": "debugpy",
      "request": "launch",
      "module": "SAM3.main",
      "python": "/opt/conda/envs/sam3/bin/python",
      "args": [
        "infer.type=person",
      ]
    },
    {
      "name": "index_mapping",
      "type": "debugpy",
      "request": "launch",
      "module": "cross_validation.generate_cv_index"
      // "args": ["--config", "configs/sam3d_hand.yaml"]
    },
    {
      "name": "unity_train",
      "type": "debugpy",
      "request": "launch",
      "module": "dual2pose.main",
      "python": "/opt/conda/envs/canonical_dualview_3d_pose/bin/python",
      "args": [
        "data.num_workers=32",
        "data.batch_size=32",
      ]
    },
    {
      "name": "unity_train_pose2equip",
      "type": "debugpy",
      "request": "launch",
      "module": "dual2pose.main",
      "python": "/opt/conda/envs/canonical_dualview_3d_pose/bin/python",
      "args": [
        "data.num_workers=0",
        "data.batch_size=2",
        "train.view=single",
        "model.backbone=pose2equip",
      ]
    },
    {
      "name": "unity_train_stgcn",
      "type": "debugpy",
      "request": "launch",
      "module": "pose2equip.main",
      "python": "/opt/conda/envs/canonical_dualview_3d_pose/bin/python",
      "args": [
        "data.num_workers=0",
        "data.batch_size=2",
        "model.backbone=stgcn",
        "data.load_frames=false"
      ]
    },
    {
      "name": "unity_train_dual2pose",
      "type": "debugpy",
      "request": "launch",
      "module": "dual2pose.main",
      "python": "/opt/conda/envs/canonical_dualview_3d_pose/bin/python",
      "args": [
        "data.num_workers=0",
        "data.batch_size=2",
        "model.backbone=crossview_fusion",
        "train.gpu=1",
      ]
    },
  ]
}